# Copy to .env, or run `openslacktag setup` to write it for you.

# ── Model ────────────────────────────────────────────────────────────────
# `anthropic`, or `openai` for any OpenAI-compatible API (OpenAI, OpenRouter,
# Groq, Together, DeepSeek, Ollama, LM Studio, vLLM, ...).
LLM_PROVIDER=anthropic
# Defaults to https://api.anthropic.com/v1 or https://api.openai.com/v1.
# Ollama: http://localhost:11434/v1   OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ── Slack (from your app's settings page; see README) ───────────────────
# Bot User OAuth Token (xoxb-...) and an app-level token with connections:write (xapp-...).
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# ── Who can use it ───────────────────────────────────────────────────────
# Only these Slack user ids may use the teammate (comma-separated). Empty: everyone in the workspace.
ALLOWED_USERS=
# Only these user ids may approve tools that ask first. Empty: whoever asked for the task.
APPROVERS=
# Allow / ask / deny rules for tools. See permissions.example.json.
PERMISSIONS=permissions.json

# ── Web search (optional) ────────────────────────────────────────────────
# brave, tavily or searxng. SearXNG needs SEARCH_URL (your instance) and no key.
SEARCH_PROVIDER=
SEARCH_API_KEY=
SEARCH_URL=

# ── Image generation (optional) ──────────────────────────────────────────
# Any OpenAI-compatible images API. Uses the chat provider's URL and key when it is
# OpenAI-compatible; set these to use another one.
IMAGE_MODEL=
IMAGE_BASE_URL=
IMAGE_API_KEY=

# ── Sandbox: the teammate's own computer (optional, needs Docker) ───────
# Any image with `sh`; `docker build -t openslacktag-sandbox sandbox/` makes a good one.
# Leave empty to turn the shell tool off.
SANDBOX_IMAGE=
# `none` (default, no network) or `bridge` (network, e.g. to pip install; it can
# also reach your LAN and cloud metadata endpoints, so see README > Safety).
SANDBOX_NETWORK=none
# Only when OpenSlackTag itself runs in Docker: the host's path to DATA_DIR.
SANDBOX_HOST_DATA_DIR=

# ── Knowledge and behaviour ──────────────────────────────────────────────
# Folders of Agent Skills (<name>/SKILL.md). See examples/skills.
SKILLS_DIR=skills
# Standing instructions added to every conversation. See examples/instructions.md.
INSTRUCTIONS=instructions.md
# MCP servers file (Claude Desktop format). See mcp.example.json.
MCP_CONFIG=mcp.json
# A channel id to post weekly automation suggestions in (Mondays 09:00).
SUGGESTIONS_CHANNEL=

# ── Time ─────────────────────────────────────────────────────────────────
# The time zone routines run in, like Europe/London. Empty: the server's
# (which is UTC inside Docker).
TZ=

# ── Storage ──────────────────────────────────────────────────────────────
# Where the wiki, transcripts, workspaces, routines, usage and audit logs live.
DATA_DIR=data
# Summarise older messages once a conversation passes this many tokens.
COMPACT_AT_TOKENS=80000
