# Copy to .env, or run `openslacktag setup` to write it for you.

# ── Model ────────────────────────────────────────────────────────────────
# `anthropic`, or `openai` for any OpenAI-compatible API (OpenAI, OpenRouter,
# Groq, Together, DeepSeek, Ollama, LM Studio, vLLM, ...).
LLM_PROVIDER=anthropic
# Defaults to https://api.anthropic.com/v1 or https://api.openai.com/v1.
# Ollama: http://localhost:11434/v1   OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ── Slack (from your app's settings page; see README) ───────────────────
# Bot User OAuth Token (xoxb-...) and an app-level token with connections:write (xapp-...).
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# ── Sandbox: the teammate's own computer (optional, needs Docker) ───────
# Any image with `sh`. Leave empty to turn the shell tool off.
SANDBOX_IMAGE=
# `none` (default, no network) or `bridge` (network, e.g. to pip install; it can
# also reach your LAN and cloud metadata endpoints, so see README > Safety).
SANDBOX_NETWORK=none

# ── Optional ─────────────────────────────────────────────────────────────
# Only these Slack user ids may use the teammate (comma-separated). Empty: everyone in the workspace.
ALLOWED_USERS=
# Where the wiki, transcripts and sandbox workspaces live.
DATA_DIR=data
# MCP servers file (Claude Desktop format). See mcp.example.json.
MCP_CONFIG=mcp.json
# Summarise older messages once a conversation passes this many tokens.
COMPACT_AT_TOKENS=80000
